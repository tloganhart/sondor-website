# Copy to .env for local dev, or set in the Cloudflare Pages project.
# Every variable is optional. Unset means the feature renders nothing or degrades gracefully.

# Where the application form POSTs its JSON payload. The endpoint does not exist yet.
# While unset, the form renders, validates, and on submit shows a "not open yet" message
# with the contact email instead of sending anything.
PUBLIC_BETA_APPLY_ENDPOINT=

# Cloudflare Web Analytics token for beta.sondor.ai. Renders the beacon when set.
PUBLIC_CF_ANALYTICS_TOKEN=

# Overrides the canonical origin used for the sitemap and canonical tags. Leave unset in production.
PUBLIC_SITE_URL=

# Set to 1 on a pre-launch deployment to add <meta name="robots" content="noindex"> to every page.
PUBLIC_NOINDEX=
