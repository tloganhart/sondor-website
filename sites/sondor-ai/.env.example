# Copy to .env for local dev, or set in the Cloudflare Pages project.
# Every variable is optional. Unset means the feature renders nothing.

# Cloudflare Web Analytics token for sondor.ai. Renders the beacon when set.
PUBLIC_CF_ANALYTICS_TOKEN=

# Overrides the canonical origin used for the sitemap and canonical tags.
# Leave unset in production. Set to the pages.dev URL for a preview build if you want
# preview canonicals to point at the preview.
PUBLIC_SITE_URL=

# Set to 1 on a pre-launch deployment to add <meta name="robots" content="noindex"> to every page.
PUBLIC_NOINDEX=
